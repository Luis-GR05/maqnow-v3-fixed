# Copia este archivo como .env y rellénalo para usar usuarios reales con Supabase.
# Sin estas variables la aplicación funciona en modo demostración (cuentas locales).
# Están en Supabase → Project Settings → API. La clave "anon" es pública por diseño;
# NUNCA pongas aquí la clave "service_role".
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
