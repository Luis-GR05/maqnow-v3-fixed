# ==============================================================================
# MAQNOW — Variables de Entorno Supabase
# ==============================================================================

# URL de tu proyecto en Supabase (ej. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Anon Public Key de tu proyecto Supabase (en Project Settings > API)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Instrucciones de configuración:
# 1. Crea un proyecto gratuito en https://supabase.com
# 2. Entra en SQL Editor y ejecuta el contenido de "supabase/schema.sql"
# 3. Copia este archivo como ".env" y sustituye los valores reales arriba
# 4. Reinicia el servidor con "npm run dev"
#
# Nota: Si no configuras las variables, MAQNOW funcionará automáticamente en
# modo local con persistencia y datos semilla interactivos.
